---
import BaseLayout from '../layouts/BaseLayout.astro';
import { companyName } from '../lib/config.ts';
import { styleguideUrl } from '../lib/urls.ts';

// ponytail: internal visual check, kept out of search (noindex) and the sitemap.
const themes = [
  { id: 'light', label: 'Light theme' },
  { id: 'dark', label: 'Dark theme' },
] as const;

const colors = [
  'background', 'surface', 'card', 'border', 'card-border', 'text', 'text-muted',
  'accent-text', 'error', 'success', 'brand-hot', 'brand-warm', 'on-gradient',
];
---
<BaseLayout
  title="Style guide"
  description={`Internal style guide for the ${companyName} website: type scale, colors, buttons, chips and cards in light and dark themes.`}
  breadcrumbs={[{ name: 'Style guide', url: styleguideUrl() }]}
  noindex
>
  <div class="sg">
    <h1 class="visually-hidden">Style guide</h1>
    {themes.map((t) => (
      <section class="sg-panel" data-theme={t.id} aria-labelledby={`sg-${t.id}`}>
        <p class="eyebrow" id={`sg-${t.id}`}>{t.label}</p>

        <h2 class="sg-h">Type scale</h2>
        <p class="display-hero">Display hero</p>
        <p class="sg-display">Display, other <span class="gradient-text">pages</span></p>
        <p class="sg-h2">Heading 2: is your data ready for AI?</p>
        <div class="reading sg-flush"><p class="sg-h2r">Heading 2 in the reading column</p></div>
        <h3>Heading 3, card title</h3>
        <p class="lead">Body large. We build the data platform first, then the AI on top.</p>
        <p>Body. Plain, warm and short. Links are <a href="#">underlined in body text</a>.</p>
        <p class="small muted">Small, muted. Captions, chips and the footer.</p>
        <p class="eyebrow">Label in accent text</p>
        <p class="stat">1,280 <span class="small muted">stat, tabular figures</span></p>

        <h2 class="sg-h">Colors</h2>
        <ul class="sg-swatches">
          {colors.map((c) => (
            <li><span class="sg-swatch" style={`background: var(--color-${c})`}></span><span class="small">{c}</span></li>
          ))}
        </ul>
        <p class="small"><span class="sg-error">Error: please enter an email.</span> <span class="sg-success">Success: thanks, we got it.</span></p>

        <h2 class="sg-h">Buttons</h2>
        <div class="sg-row">
          <a class="btn btn-primary" href="#">Request a Data &amp; AI Readiness Review</a>
          <a class="btn btn-primary btn-sm" href="#">Request a review</a>
          <a class="btn btn-ghost" href="#">Talk to us</a>
          <button class="btn btn-ghost btn-sm" type="button">Small ghost</button>
        </div>

        <h2 class="sg-h">Chips</h2>
        <div class="sg-row">
          <span class="chip">Microsoft Fabric</span>
          <span class="chip">Databricks</span>
          <button class="chip" type="button" aria-pressed="false">All industries</button>
          <button class="chip" type="button" aria-pressed="true">Healthcare</button>
        </div>

        <h2 class="sg-h">Cards</h2>
        <div class="card-grid">
          <div class="card">
            <p class="eyebrow">Eyebrow</p>
            <h3>Static card</h3>
            <p class="small muted">Card background, 1px card border, 16px radius.</p>
          </div>
          <a class="card card-interactive" href="#">
            <h3>Interactive card</h3>
            <p class="small muted">Hover darkens the border and underlines the title.</p>
          </a>
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .sg {
    display: grid;
    grid-template-columns: 1fr;
  }
  @media (min-width: 1024px) {
    .sg {
      grid-template-columns: 1fr 1fr;
    }
  }
  .sg-panel {
    background: var(--color-background);
    color: var(--color-text);
    padding: var(--space-7) var(--gutter);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
  }
  .sg-h {
    margin-top: var(--space-6);
    font-size: var(--type-heading-3-size);
    line-height: var(--type-heading-3-line);
    letter-spacing: var(--type-heading-3-tracking);
    color: var(--color-text-muted);
  }
  .sg-display {
    font-size: var(--type-display-size);
    font-weight: var(--type-display-weight);
    line-height: var(--type-display-line);
    letter-spacing: var(--type-display-tracking);
  }
  .sg-h2 {
    font-size: var(--type-heading-2-size);
    font-weight: var(--type-heading-2-weight);
    line-height: var(--type-heading-2-line);
    letter-spacing: var(--type-heading-2-tracking);
  }
  .sg-h2r {
    font-size: var(--type-heading-2-reading-size);
    font-weight: var(--type-heading-2-reading-weight);
    line-height: var(--type-heading-2-reading-line);
    letter-spacing: var(--type-heading-2-reading-tracking);
  }
  .sg-flush {
    padding-inline: 0;
    margin-inline: 0;
  }
  .sg-swatches {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: var(--space-3);
  }
  .sg-swatches li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .sg-swatch {
    width: var(--space-6);
    height: var(--space-6);
    flex: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }
  .sg-error {
    color: var(--color-error);
  }
  .sg-success {
    color: var(--color-success);
  }
  .sg-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }
</style>
