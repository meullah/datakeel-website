---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import { industries } from '../../lib/industries.ts';
import { homeUrl, industryUrl } from '../../lib/urls.ts';

export function getStaticPaths() {
  return industries.map((industry) => ({ params: { id: industry.id }, props: { industry } }));
}

const { industry } = Astro.props;
// "Industries" has no page, so the crumb trail is Home / {Industry} (assertCrumbs needs a real url per crumb).
const breadcrumbs = [{ name: industry.h1, url: industryUrl(industry.id) }];
---
<BaseLayout title={industry.title} description={industry.description} breadcrumbs={breadcrumbs}>
  <section class="section">
    <div class="container">
      <nav aria-label="Breadcrumb" class="small muted">
        <a href={homeUrl()}>Home</a> / <span aria-current="page">{industry.h1}</span>
      </nav>
      <h1 class="display">{industry.h1}</h1>
      <p class="lead">{industry.summary}</p>
    </div>
  </section>
  <ClosingCta />
</BaseLayout>
