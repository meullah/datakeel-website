---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseCard from '../../components/CaseCard.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import Faq from '../../components/Faq.astro';
import { getFaqs, getIndustries, getPublished } from '../../lib/content.ts';
import { faqPageNode } from '../../lib/seo.ts';
import { caseStudiesUrl, homeUrl, howWeWorkUrl, industryUrl, whatWeDoUrl } from '../../lib/urls.ts';

export async function getStaticPaths() {
  return (await getIndustries()).map((industry) => ({ params: { id: industry.id }, props: { industry } }));
}

const { id, data: industry } = Astro.props.industry;
const cases = (await getPublished('caseStudies')).filter((c) => c.data.industry.id === id);
// "Industries" has no page, so the crumb trail is Home / {Industry} (assertCrumbs needs a real url per crumb).
const breadcrumbs = [{ name: industry.name, url: industryUrl(id) }];
// FAQ file per industry: src/content/faqs/industries-{id}.json (Story 8.3).
const faqs = await getFaqs(`industries-${id}`);
const lower = industry.name.toLowerCase();
---
<BaseLayout title={industry.title} description={industry.description} breadcrumbs={breadcrumbs} graph={[faqPageNode(faqs, industryUrl(id))]}>
  <section class="section">
    <div class="container">
      <nav aria-label="Breadcrumb" class="small muted breadcrumb">
        <a href={homeUrl()}>Home</a> / <span aria-current="page">{industry.name}</span>
      </nav>
      <h1 class="display">{industry.h1}</h1>
      <p class="lead intro">{industry.intro}</p>
      <h2 class="block-title">Typical data problems</h2>
      <p class="block-answer">In {lower}, the same few data problems tend to hold teams back.</p>
      <ul class="problems" data-industry-problems>
        {industry.problems.map((p) => <li>{p}</li>)}
      </ul>
      <p class="block-more">See <a href={whatWeDoUrl()}>what we do</a> about problems like these, and <a href={howWeWorkUrl()}>how we work</a>.</p>
      <h2 class="block-title">Case studies</h2>
      {cases.length > 0 && <p class="block-answer">These projects show what was wrong, what was built and what changed.</p>}
      {cases.length > 0 ? (
        <div class="case-grid">
          {cases.map((entry) => <CaseCard entry={entry} summary />)}
        </div>
      ) : (
        <p>No case studies here yet. <a href={caseStudiesUrl()}>See all case studies.</a></p>
      )}
    </div>
  </section>
  <Faq items={faqs} heading={`Questions about ${lower} data`} intro={`Short answers to what ${lower} teams usually ask us.`} />
  <ClosingCta />
</BaseLayout>

<style>
  .breadcrumb {
    margin-bottom: var(--space-4);
  }
  .intro,
  .problems {
    max-width: var(--reading-max);
  }
  /* Reading-size h2, matching the case study sections. */
  .block-title {
    margin: var(--space-8) 0 var(--space-5);
    font-size: var(--type-heading-2-reading-size);
    font-weight: var(--type-heading-2-reading-weight);
    line-height: var(--type-heading-2-reading-line);
    letter-spacing: var(--type-heading-2-reading-tracking);
  }
  .block-title:has(+ .block-answer) {
    margin-bottom: var(--space-3);
  }
  .block-answer {
    max-width: var(--reading-max);
    margin: 0 0 var(--space-5);
    color: var(--color-text-muted);
  }
  .block-more {
    max-width: var(--reading-max);
    margin: var(--space-5) 0 0;
  }
  .problems {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding-left: 1.25em;
  }
</style>
