---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import { getIndustries } from '../../lib/content.ts';
import { homeUrl, industryUrl } from '../../lib/urls.ts';

export async function getStaticPaths() {
  return (await getIndustries()).map((industry) => ({ params: { id: industry.id }, props: { industry } }));
}

const { id, data: industry } = Astro.props.industry;
// "Industries" has no page, so the crumb trail is Home / {Industry} (assertCrumbs needs a real url per crumb).
const breadcrumbs = [{ name: industry.h1, url: industryUrl(id) }];
---
<BaseLayout title={industry.title} description={industry.description} breadcrumbs={breadcrumbs}>
  <section class="section">
    <div class="container">
      <nav aria-label="Breadcrumb" class="small muted breadcrumb">
        <a href={homeUrl()}>Home</a> / <span aria-current="page">{industry.h1}</span>
      </nav>
      <h1 class="display">{industry.h1}</h1>
      <p class="lead">{industry.summary}</p>
    </div>
  </section>
  <ClosingCta />
</BaseLayout>

<style>
  .breadcrumb {
    margin-bottom: var(--space-4);
  }
</style>
