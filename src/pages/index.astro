---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClosingCta from '../components/ClosingCta.astro';
import Hero from '../components/Hero.astro';
import ProblemSection from '../components/ProblemSection.astro';
import ServiceCards from '../components/ServiceCards.astro';
import StackSection from '../components/StackSection.astro';
import StatStrip from '../components/StatStrip.astro';
import WhereItHelps from '../components/WhereItHelps.astro';
import { companyName, positioningLine } from '../lib/config.ts';
---
<BaseLayout fullTitle={`${companyName}: The Data Backbone Your AI Runs On`} description={positioningLine} transparentHeader>
  <Hero />
  <StatStrip />
  <ProblemSection />
  <ServiceCards />
  <WhereItHelps />
  <StackSection />
  <ClosingCta />
</BaseLayout>
