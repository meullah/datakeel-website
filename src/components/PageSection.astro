---
// An answer-first h2 section from a pages.json section: heading, the answer line, then optional items as cards
// (or a numbered list with `ordered`) and any extra content in the slot.
import type { CollectionEntry } from 'astro:content';

type Section = CollectionEntry<'pages'>['data']['sections'][number];
export type Props = { section: Section; surface?: boolean; ordered?: boolean };
const { section, surface = false, ordered = false } = Astro.props;
const List = ordered ? 'ol' : 'ul';
---
<section class:list={['section', { 'section-surface': surface }]} aria-labelledby={`${section.id}-heading`} data-section={section.id}>
  <div class="container">
    <h2 id={`${section.id}-heading`}>{section.heading}</h2>
    <p class="lead muted page-answer">{section.answer}</p>
    {section.items && (
      <List class:list={['page-items', ordered ? 'page-items-ordered' : 'card-grid']} role="list">
        {section.items.map((item) => (
          <li class:list={{ card: !ordered }}><h3>{item.title}</h3><p class="muted">{item.text}</p></li>
        ))}
      </List>
    )}
    <slot />
  </div>
</section>

<style>
  .page-answer {
    max-width: 720px;
    margin-top: var(--space-4);
  }
  .page-items {
    margin: var(--space-7) 0 0;
    padding: 0;
    list-style: none;
  }
  .page-items h3 {
    margin-bottom: var(--space-2);
  }
  .page-items p {
    margin: 0;
  }
  .page-items-ordered {
    max-width: var(--reading-max);
    counter-reset: item;
  }
  .page-items-ordered li {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--space-4);
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-border);
  }
  .page-items-ordered li:last-child {
    border-bottom: 1px solid var(--color-border);
  }
  .page-items-ordered li::before {
    counter-increment: item;
    content: counter(item, decimal-leading-zero) / "";
    grid-row: span 2;
    color: var(--color-accent-text);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
</style>
