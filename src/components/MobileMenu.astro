---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { cta } from '../lib/config.ts';
import { getIndustries } from '../lib/content.ts';
import { isCurrent } from '../lib/pure/nav.ts';
import {
  aboutUrl,
  caseStudiesUrl,
  contactUrl,
  guidesUrl,
  howWeWorkUrl,
  industryUrl,
  readinessReviewUrl,
  selfAssessmentUrl,
  standardUrl,
  whatWeDoUrl,
} from '../lib/urls.ts';

export type Props = {
  current: string;
};

const { current } = Astro.props;
const industries = await getIndustries();
const link = (label: string, href: string) => ({ label, href, current: isCurrent(current, href) });
const primaryLinks = [
  link('What We Do', whatWeDoUrl()),
  link('How We Work', howWeWorkUrl()),
  link('Case Studies', caseStudiesUrl()),
];
const industryLinks = industries.map((industry) => link(industry.data.name, industryUrl(industry.id)));
const finalLinks = [link('Guides', guidesUrl()), link('Standard', standardUrl()), link('About', aboutUrl())];
const secondaryLinks = [link('Contact', contactUrl()), link('Self-Assessment', selfAssessmentUrl())];
const readinessReview = link(cta.primary, readinessReviewUrl());
---
<dialog id="mobile-menu" class="mobile-menu" data-mobile-menu role="dialog" aria-modal="true" aria-label="Menu">
  <div class="menu-shell">
    <div class="menu-header">
      <Logo id="mobile-menu" current={current === '/'} />
      <button class="menu-close" type="button" data-mobile-menu-close aria-label="Close menu">
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
          <path d="m4.5 4.5 11 11m0-11-11 11" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <div class="menu-body">
      <nav class="menu-primary" aria-label="Main">
        <ul class="menu-list">
          {primaryLinks.map((item) => <li><a class="menu-link" href={item.href} aria-current={item.current}>{item.label}</a></li>)}
          <li class="industries-group">
            <span class="menu-label" id="mobile-menu-industries">Industries</span>
            <ul class="industry-list" aria-labelledby="mobile-menu-industries">
              {industryLinks.map((item) => <li><a class="industry-link" href={item.href} aria-current={item.current}>{item.label}</a></li>)}
            </ul>
          </li>
          {finalLinks.map((item) => <li><a class="menu-link" href={item.href} aria-current={item.current}>{item.label}</a></li>)}
        </ul>
      </nav>

      <div class="menu-bottom">
        <nav aria-label="Secondary">
          <ul class="secondary-list">
            {secondaryLinks.map((item) => <li><a class="secondary-link" href={item.href} aria-current={item.current}>{item.label}</a></li>)}
          </ul>
        </nav>
        <div class="theme-row">
          <span>Theme</span>
          <ThemeToggle />
        </div>
        <a class="btn btn-primary menu-cta" href={readinessReview.href} aria-current={readinessReview.current}>{readinessReview.label}</a>
      </div>
    </div>
  </div>
</dialog>

<script>
  import '../islands/mobile-menu.ts';
</script>

<style>
  .mobile-menu {
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background: var(--color-background);
    color: var(--color-text);
    border: 0;
  }
  .mobile-menu::backdrop {
    background: var(--color-background);
  }
  .menu-shell {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
  }
  .menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-height);
    padding-inline: var(--gutter);
    border-bottom: 1px solid var(--color-border);
    flex-shrink: 0;
    --logo-width: 132px;
  }
  .menu-close {
    display: inline-grid;
    place-items: center;
    width: var(--touch-min);
    height: var(--touch-min);
    padding: 0;
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    cursor: pointer;
  }
  .menu-body {
    display: grid;
    flex: 1;
    grid-template-rows: minmax(0, 1fr) auto;
    min-height: 0;
    padding-inline: var(--gutter);
    overflow: hidden;
  }
  .menu-primary {
    min-height: 0;
    padding-top: var(--space-2);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .menu-list,
  .industry-list,
  .secondary-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .menu-list > li {
    border-bottom: 1px solid var(--color-border);
  }
  .menu-link,
  .industry-link,
  .secondary-link,
  .menu-label {
    display: flex;
    align-items: center;
    min-height: var(--touch-min);
    color: var(--color-text);
    font-size: var(--type-heading-3-size);
    font-weight: var(--type-heading-3-weight);
    line-height: var(--type-heading-3-line);
    text-decoration: none;
  }
  .menu-link {
    min-height: 52px;
  }
  :is(.menu-link, .industry-link, .secondary-link)[aria-current] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
  }
  .menu-label {
    padding-top: var(--space-2);
  }
  .industry-list {
    padding: 0 0 var(--space-3) var(--space-4);
  }
  .industry-link {
    color: var(--color-text-muted);
  }
  .menu-bottom {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-4) var(--space-6);
    background: var(--color-background);
    border-top: 1px solid var(--color-border);
  }
  .secondary-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-3);
  }
  .secondary-link {
    justify-content: center;
    min-width: 0;
    padding-inline: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    text-align: center;
    white-space: nowrap;
  }
  .theme-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--touch-min);
    color: var(--color-text-muted);
  }
  :global(.theme-row .theme-toggle) {
    min-width: var(--touch-min);
    min-height: var(--touch-min);
  }
  .menu-cta {
    width: 100%;
  }

  @media (width >= 1024px) {
    .mobile-menu {
      display: none;
    }
  }
</style>
