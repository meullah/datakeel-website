---
// Hero Story: decorative canvas plus scene indicator (aria-hidden), and the pause button outside that box
// so it stays focusable. The slot (shade and copy) goes between them: shade over the canvas, pause last in tab order.
// Indicator and pause render hidden; the hero-story island reveals them once it runs.
import { SCENE_LABELS } from '../lib/pure/story-scenes.ts';
---
<div class="hero-visual" data-hero-visual aria-hidden="true">
  <canvas class="hero-canvas" data-hero-story-canvas></canvas>
  <span class="hero-indicator" data-hero-story-indicator hidden>
    <span class="hero-scene" data-hero-story-name></span>
    <span class="hero-ticks" data-hero-story-ticks>{SCENE_LABELS.map(() => <i />)}</span>
  </span>
</div>
<slot />
<button class="hero-pause" type="button" data-hero-story-pause aria-label="Pause background animation" hidden>
  <svg class="icon-pause" width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><rect x="2" y="1" width="3" height="10" /><rect x="7" y="1" width="3" height="10" /></svg>
  <svg class="icon-play" width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M3 1.5v9l7.5-4.5z" /></svg>
</button>

<script>
  import '../islands/hero-story/index.ts';
</script>

<style>
  /* Covers the whole hero, like the prototype's canvas, so scenes are never clipped; the shade sits above it. */
  .hero-visual {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* Logo collapse (set by the island unless reduced motion): pinned to the viewport at the hero's size, so the
     scene draws where it always does and can fly into the header logo. Above the header (50) only while docking. */
  .hero-canvas[data-docking] {
    position: fixed;
    top: 0;
    left: 0;
    bottom: auto;
    height: max(620px, 100vh);
    height: max(620px, 100svh);
  }
  @media (max-height: 500px) {
    .hero-canvas[data-docking] {
      height: 100vh;
      height: 100svh;
    }
  }
  .hero-canvas.is-docking {
    z-index: 60;
  }
  /* Indicator and pause share one 36px row at the bottom, above the shade. */
  .hero-indicator,
  .hero-pause {
    position: absolute;
    z-index: 1;
    bottom: var(--space-5);
  }
  .hero-indicator {
    right: var(--hero-pad-x);
    display: flex;
    align-items: center;
    gap: 14px;
    height: 36px;
  }
  .hero-scene {
    min-width: 110px;
    text-align: right;
    color: var(--color-accent-text);
    font-size: var(--type-label-size);
    font-weight: var(--type-label-weight);
    line-height: var(--type-label-line);
  }
  .hero-ticks {
    display: flex;
    gap: 6px;
  }
  .hero-ticks i {
    width: 18px;
    height: 3px;
    border-radius: 3px;
    background: var(--color-border);
    transition:
      background 0.4s,
      width 0.4s;
  }
  .hero-ticks i.is-current {
    width: 34px;
    background: var(--gradient-brand);
  }
  .hero-pause {
    left: var(--hero-pad-x);
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    background: transparent;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    cursor: pointer;
    pointer-events: auto;
    transition:
      color var(--duration) ease,
      border-color var(--duration) ease;
  }
  .hero-pause:hover {
    color: var(--color-text);
    border-color: var(--color-brand-warm);
  }
  .icon-play,
  .hero-pause[data-paused] .icon-pause {
    display: none;
  }
  .hero-pause[data-paused] .icon-play {
    display: block;
  }
  .hero-indicator[hidden],
  .hero-pause[hidden] {
    display: none;
  }

  @media (max-width: 1023px) { /* phones and tablets: animation on top, copy below (founder 2026-11-04) */
    /* Full width beside the pause button. */
    .hero-indicator {
      left: calc(var(--hero-pad-x) + 36px + var(--space-3));
      justify-content: space-between;
    }
    .hero-scene {
      flex-shrink: 0;
      min-width: 0;
      text-align: left;
      white-space: nowrap;
    }
    /* Ticks give way to the scene name on narrow phones, so the name never runs into them. */
    .hero-ticks {
      min-width: 0;
    }
    .hero-ticks i {
      flex: 0 1 18px;
      min-width: 6px;
    }
    .hero-ticks i.is-current {
      flex-basis: 34px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-ticks i {
      transition: none;
    }
  }
</style>
