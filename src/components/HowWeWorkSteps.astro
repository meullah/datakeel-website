---
// Review → Design → Build → Run (01-04). Step lines live in pages.json (how-we-work, section "steps"), so the
// homepage and the How We Work page always say the same; homepage lines are founder-approved (homepage-epic5.md §5.4).
// `detailed` (How We Work page): the section's own heading and answer, plus each step's "What you get" line.
import { getPage, sectionOf } from '../lib/content.ts';
import { readinessReviewUrl } from '../lib/urls.ts';

export type Props = { detailed?: boolean };
const { detailed = false } = Astro.props;
const section = sectionOf(await getPage('how-we-work'), 'steps');
const steps = section.items ?? [];
if (steps.length !== 4) throw new Error(`pages/how-we-work: section "steps" needs 4 items, found ${steps.length}`);
const heading = detailed ? section.heading : 'How do we work?';
const answer = detailed ? section.answer : 'Four steps, starting with a short fixed-price review so you know where you stand.';
---
<section class="section section-surface" aria-labelledby="process-heading" data-section="process" data-reveal={!detailed || undefined}>
  <div class="container">
    <h2 id="process-heading">{heading}</h2>
    <p class="lead muted section-answer">{answer}</p>
    <ol class="steps" role="list">
      {steps.map((step, i) => (
        <li>
          <p class="steps-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
          <h3>{i === 0 ? <a href={readinessReviewUrl()}>{step.title}</a> : step.title}</h3>
          <p class="muted">{step.text}</p>
          {detailed && step.detail && <p class="steps-detail">{step.detail}</p>}
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-6);
    margin: var(--space-7) 0 0;
    padding: 0;
    list-style: none;
  }
  .steps li {
    padding-top: var(--space-4);
    border-top: 2px solid var(--color-border);
  }
  .steps-num {
    margin: 0 0 var(--space-2);
    color: var(--color-accent-text);
    font-size: var(--type-stat-size);
    font-weight: var(--type-stat-weight);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .steps h3 {
    margin-bottom: var(--space-2);
  }
  .steps p:last-child {
    margin: 0;
  }
  .steps-detail {
    margin-top: var(--space-4);
  }
</style>
