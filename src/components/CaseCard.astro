---
// The one case study card (index, related cases, industry pages, homepage). One link: the headline, stretched over the card.
import type { CollectionEntry } from 'astro:content';
import { getIndustries } from '../lib/content.ts';
import { caseStudyUrl } from '../lib/urls.ts';

export type Props = {
  entry: CollectionEntry<'caseStudies'>;
  /** Show the Card summary (the index does; related cards don't). */
  summary?: boolean;
  /** Heading level for the headline; it always looks like heading-3. */
  level?: 2 | 3;
};

const { entry, summary = false, level = 3 } = Astro.props;
const { data } = entry;
const industry = (await getIndustries()).find((i) => i.id === data.industry.id);
if (!industry) throw new Error(`caseStudies/${entry.id}: unknown industry "${data.industry.id}"`);
const cut = data.cardLine.lastIndexOf(' · ');
const [line, lineMuted] = cut < 0 ? [data.cardLine, ''] : [data.cardLine.slice(0, cut), data.cardLine.slice(cut + 1)];
const Heading = `h${level}` as const;
---
<article class="card card-interactive case-card" data-case-card data-industry={industry.id}>
  <p class="case-card-tags muted">{industry.data.name} · {data.serviceLabel}</p>
  {data.framingLabel && <p class="case-card-pill">{data.framingLabel}</p>}
  <Heading class="case-card-title"><a href={caseStudyUrl(entry.id)}>{data.headline}</a></Heading>
  <p class="small">{line}{lineMuted && <> <span class="muted">{lineMuted}</span></>}</p>
  {summary && <p class="small">{data.cardSummary}</p>}
  <ul class="case-card-stack" aria-label="Stack">
    {data.stack.slice(0, 3).map((tool) => <li class="chip">{tool}</li>)}
  </ul>
</article>

<style>
  .case-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .case-card[hidden] {
    display: none;
  }
  .case-card p {
    margin: 0;
  }
  .case-card-tags {
    font-size: var(--type-label-size);
    font-weight: var(--type-label-weight);
    line-height: var(--type-label-line);
  }
  .case-card-pill {
    align-self: flex-start;
    padding: 2px 10px;
    color: var(--color-accent-text);
    border: 1px solid currentColor;
    border-radius: var(--radius-full);
    font-size: var(--type-small-size);
    line-height: var(--type-small-line);
  }
  .case-card-title {
    margin: 0;
    font-size: var(--type-heading-3-size);
    font-weight: var(--type-heading-3-weight);
    line-height: var(--type-heading-3-line);
    letter-spacing: var(--type-heading-3-tracking);
  }
  .case-card-title a {
    color: inherit;
    text-decoration: none;
  }
  /* Stretch the one link over the whole card. */
  .case-card-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .case-card-stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: auto 0 0;
    padding: var(--space-1) 0 0;
    list-style: none;
  }
</style>
