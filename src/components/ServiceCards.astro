---
// "What we do": one card per services entry, each one link to its section on /what-we-do/. Reused on What We Do (Epic 6).
// Copy is founder-approved (2026-11-05, homepage-epic5.md §5.2); one-liners live in services.json.
import { getPublished } from '../lib/content.ts';
import { whatWeDoUrl } from '../lib/urls.ts';

const services = await getPublished('services');
---
<section class="section section-surface" aria-labelledby="services-heading" data-section="services" data-reveal>
  <div class="container">
    <h2 id="services-heading">What we do</h2>
    <p class="lead muted services-answer">We design, build and run the data platform, then help you put AI on top of it.</p>
    <ul class="card-grid services-grid" role="list">
      {services.map((s) => (
        <li class="card card-interactive card-stretch service-card" data-service={s.id}>
          <h3><a href={`${whatWeDoUrl()}#${s.id}`}>{s.data.name}</a></h3>
          <p class="muted">{s.data.summary}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .services-answer {
    max-width: 720px;
  }
  .services-grid {
    margin-top: var(--space-7);
    padding: 0;
    list-style: none;
  }
  .service-card h3 {
    margin-bottom: var(--space-2);
  }
  .service-card p {
    margin: 0;
  }
</style>
