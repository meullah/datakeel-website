---
// Site header: logo, main nav in IA order, Industries dropdown, theme toggle, short Primary CTA.
// Islands: nav-dropdown (Industries) and header-scroll (homepage solid state + Hero Story dock hook).
import Logo from './Logo.astro';
import MobileMenu from './MobileMenu.astro';
import ThemeToggle from './ThemeToggle.astro';
import { cta } from '../lib/config.ts';
import { getIndustries } from '../lib/content.ts';
import { isCurrent } from '../lib/pure/nav.ts';
import {
  aboutUrl,
  caseStudiesUrl,
  guidesUrl,
  homeUrl,
  howWeWorkUrl,
  industryUrl,
  readinessReviewUrl,
  standardUrl,
  whatWeDoUrl,
} from '../lib/urls.ts';

export type Props = {
  /** Current path with a trailing slash. */
  current: string;
  /** Homepage only: transparent until the page scrolls. */
  transparent?: boolean;
};

const { current, transparent = false } = Astro.props;
const industries = await getIndustries();
const link = (label: string, href: string) => ({ label, href, current: isCurrent(current, href) });
const before = [link('What We Do', whatWeDoUrl()), link('How We Work', howWeWorkUrl()), link('Case Studies', caseStudiesUrl())];
const after = [link('Guides', guidesUrl()), link('Standard', standardUrl()), link('About', aboutUrl())];
const industryLinks = industries.map((i) => link(i.data.name, industryUrl(i.id)));
// No /industries/ page exists, so the trigger is the section parent of the four pages.
const industriesCurrent = industryLinks.some((l) => l.current) ? 'true' : undefined;
---
<header class="site-header" data-header data-transparent={transparent ? '' : undefined}>
  <div class="container bar">
    <span class="header-logo">
      <Logo id="header" dockTarget current={current === homeUrl()} />
    </span>
    <nav class="nav" aria-label="Main">
      <ul class="nav-list">
        {before.map((l) => <li><a class="nav-link" href={l.href} aria-current={l.current}>{l.label}</a></li>)}
        <li class="dropdown" data-nav-dropdown>
          <button class="nav-link dropdown-trigger" type="button" aria-expanded="false" aria-controls="nav-industries" aria-current={industriesCurrent}>
            Industries
            <svg class="caret" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true" focusable="false">
              <path d="M2 3.5 5 6.5 8 3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <ul class="dropdown-menu" id="nav-industries">
            {industryLinks.map((l) => <li><a class="dropdown-link" href={l.href} aria-current={l.current}>{l.label}</a></li>)}
          </ul>
        </li>
        {after.map((l) => <li><a class="nav-link" href={l.href} aria-current={l.current}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="actions">
      <ThemeToggle />
      <a class="btn btn-primary btn-sm header-cta" href={readinessReviewUrl()} aria-current={isCurrent(current, readinessReviewUrl())}>{cta.primaryShort}</a>
      <button class="menu-trigger" type="button" data-mobile-menu-trigger aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu" hidden>
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
          <path d="M3 5.5h14M3 10h14M3 14.5h14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>
</header>
<MobileMenu current={current} />

<script>
  import '../islands/nav-dropdown.ts';
  import '../islands/header-scroll.ts';
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-height);
    background: var(--color-background);
    /* Border always present (transparent when hidden), so turning solid never shifts layout. */
    border-bottom: 1px solid var(--color-border);
    transition:
      background-color var(--duration) ease,
      border-color var(--duration) ease;
  }
  /* Homepage: pull the hero up under the header so the transparent state shows the hero. */
  .site-header[data-transparent] {
    margin-bottom: calc(-1 * var(--header-height));
  }
  .site-header[data-transparent]:not([data-solid]) {
    background: transparent;
    border-bottom-color: transparent;
  }
  .site-header[data-transparent][data-solid] {
    background: color-mix(in srgb, var(--color-background) 88%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
  /* No JS means no header-scroll: keep the homepage header solid. */
  @media (scripting: none) {
    .site-header[data-transparent]:not([data-solid]) {
      background: var(--color-background);
      border-bottom-color: var(--color-border);
    }
  }

  .bar {
    display: flex;
    align-items: center;
    height: 100%;
  }
  /* Fluid from 1024px to 1280px+: logo 110px to 132px (brand minimum 100px), gap after it 12px to 24px. */
  .header-logo {
    display: inline-flex;
    flex-shrink: 0;
    --logo-width: clamp(110px, 8.59375vw + 22px, 132px);
    margin-inline-end: clamp(var(--space-3), 4.6875vw - 36px, var(--space-5));
  }
  /* Hero Story logo collapse: header-scroll sets --hero-dock to the mark's opacity for the dock progress.
     Only the mark fades (the particles replace it); the wordmark stays put. */
  :global(html[data-hero-dock]) .header-logo :global([data-dock-target]) {
    opacity: var(--hero-dock, 1);
  }

  .nav {
    margin-left: auto;
  }
  .nav-list,
  .dropdown-menu {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-list {
    display: flex;
    align-items: center;
    /* Fluid: 0 at 1024px up to 4px (--space-1) at 1280px+. */
    gap: clamp(0px, 1.5625vw - 16px, var(--space-1));
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--touch-min);
    /* Fluid: 4px at 1024px up to 12px (--space-3) at 1280px+, so the full header fits from 1024px. */
    padding: 0 clamp(var(--space-1), 3.125vw - 28px, var(--space-3));
    background: transparent;
    border: 0;
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    font-size: var(--type-small-size);
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
  }
  .nav-link:hover,
  .nav-link[aria-current] {
    color: var(--color-text);
  }
  .nav-link[aria-current] {
    text-decoration: underline;
    text-underline-offset: 0.35em;
    text-decoration-thickness: 1px;
  }

  .dropdown {
    position: relative;
  }
  .caret {
    transition: transform var(--duration) ease;
  }
  .dropdown-trigger[aria-expanded="true"] .caret {
    transform: rotate(180deg);
  }
  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    display: none;
    min-width: 200px;
    padding: var(--space-2);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  /* Open: set by the island; without JS, keyboard focus inside the dropdown reveals the list. */
  .dropdown-trigger[aria-expanded="true"] + .dropdown-menu,
  .dropdown:not([data-js]):focus-within .dropdown-menu,
  .dropdown:not([data-js]):hover .dropdown-menu {
    display: block;
  }
  .dropdown-link {
    display: flex;
    align-items: center;
    min-height: var(--touch-min);
    padding: 0 var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    font-size: var(--type-small-size);
    text-decoration: none;
  }
  .dropdown-link[aria-current] {
    text-decoration: underline;
    text-underline-offset: 0.35em;
    text-decoration-thickness: 1px;
  }
  .dropdown-link:hover {
    color: var(--color-text);
    background: var(--color-card);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
    margin-inline-start: var(--space-5);
  }
  .header-cta {
    white-space: nowrap;
  }
  .menu-trigger {
    display: none;
    place-items: center;
    width: var(--touch-min);
    height: var(--touch-min);
    padding: 0;
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    cursor: pointer;
  }

  /* The small Primary is 40px; extend its hit area to 44px. */
  .header-cta {
    position: relative;
  }
  .header-cta::after {
    content: '';
    position: absolute;
    inset: calc((var(--control-height-sm) - var(--touch-min)) / 2) 0;
  }

  /* Story 1.6 moved the compact header breakpoint from 768px to 1024px. */
  @media (width < 1024px) {
    .nav,
    .header-cta {
      display: none;
    }
    .actions {
      margin-left: auto;
    }
    .header-logo {
      --logo-width: 132px;
    }
    .menu-trigger:not([hidden]) {
      display: inline-grid;
    }
  }
</style>
