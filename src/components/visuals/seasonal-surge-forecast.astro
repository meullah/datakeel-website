---
// Case 3 Visual: monthly seasonal admissions over several years, the forecast extending ahead,
// and a shaded "beds needed" band beneath it. Illustrative: demo shape only, no client data, no figures.
import CaseVisual from '../CaseVisual.astro';
// Always a dashboard: demo data keeps its "Illustrative" frame whatever the entry's `visual.kind` says.

// Demo seasonal shape (rises from midsummer through the rainy season), repeated with slight growth.
const shape = [20, 18, 20, 24, 30, 55, 85, 100, 90, 60, 32, 24];
const growth = [0.85, 0.95, 1, 1.05, 1.05];
const value = (m: number) => shape[m % 12] * growth[Math.min(Math.floor(m / 12), growth.length - 1)];
const base = 170, x0 = 8, dx = 6.2, past = 36, total = 51;
const pt = (m: number) => `${(x0 + m * dx).toFixed(1)} ${(base - value(m) * 1.1).toFixed(1)}`;
const line = (from: number, to: number) => Array.from({ length: to - from }, (_, i) => `${i ? 'L' : 'M'}${pt(from + i)}`).join(' ');
const pastPath = line(0, past);
const forecastPath = line(past - 1, total);
const xNow = x0 + (past - 1) * dx;
const xEnd = x0 + (total - 1) * dx;
const bandPath = `${forecastPath} L${xEnd.toFixed(1)} ${base} L${xNow.toFixed(1)} ${base} Z`;
---
<CaseVisual kind="dashboard" caption="Admissions rise in the same season every year, so the forecast shows the beds needed before the surge.">
  <svg viewBox="0 0 330 232" role="img" aria-labelledby="vis-ssf-title" aria-describedby="vis-ssf-desc">
    <title id="vis-ssf-title">Monthly seasonal admissions over several years, with the forecast extending ahead and a shaded beds needed band beneath it.</title>
    <desc id="vis-ssf-desc">Illustrative, with demo data. A line of monthly admissions over past years rises and falls in the same season each year. A dashed forecast line continues the pattern into the months ahead, with a shaded band beneath it showing the beds needed.</desc>
    <defs>
      <linearGradient id="vis-ssf-flow" gradientUnits="userSpaceOnUse" x1={x0} y1="0" x2={xEnd} y2="0">
        <stop offset="0" class="dg-stop-warm" /><stop offset="1" class="dg-stop-hot" />
      </linearGradient>
    </defs>
    <text class="dg-label" x="0" y="16">Monthly admissions</text>
    <path class="dg-band" d={bandPath} />
    <path class="dg-line" d={`M${xNow.toFixed(1)} 32 L${xNow.toFixed(1)} ${base}`} stroke-dasharray="3 4" />
    <path class="dg-line" d={`M0 ${base} L330 ${base}`} />
    <path class="dg-data" d={pastPath} stroke="url(#vis-ssf-flow)" />
    <path class="dg-data" d={forecastPath} stroke="url(#vis-ssf-flow)" stroke-dasharray="6 4" />
    <text x={(x0 + xNow) / 2} y="192" text-anchor="middle">Past years</text>
    <text x={(xNow + xEnd) / 2} y="192" text-anchor="middle">Forecast</text>
    <rect class="dg-band" x="0" y="211" width="18" height="12" rx="2" />
    <text x="26" y="222">Beds needed</text>
  </svg>
</CaseVisual>
